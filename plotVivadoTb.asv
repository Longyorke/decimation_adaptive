end


% Helper function
function dec_val = hex2dec_signed(hex_str, word_length)
    val = uint64(hex2dec(hex_str)); 
    if bitget(val, word_length) == 1
        dec_val = double(val) - 2^word_length;
    else
        dec_val = double(val);
    end
end
